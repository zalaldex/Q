{
  "version": "1.0.0",
  "services": [
    {
      "name": "telegram-monospace-bot",
      "type": "docker",
      "build": {
        "dockerfilePath": "Dockerfile"
      },
      "run": {
        "command": ["python", "run.py"]
      },
      "env": [
        {
          "name": "BOT_TOKEN",
          "required": true,
          "description": "Telegram bot token (format: 123456:ABC-DEF...)"
        }
      ],
      "resources": {
        "cpu": 0.5,
        "memory": 512
      },
      "scale": {
        "min": 1,
        "max": 1
      }
    }
  ],
  "metadata": {
    "description": "Telegram monospace bot - converts messages to monospace preserving content. One env var: BOT_TOKEN"
  }
}
